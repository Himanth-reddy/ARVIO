<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ARVIO TV Splash Theme - Shows immediately on app launch -->
    <style name="Theme.ArflixTV.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <!-- Post-splash transitions to Mobile theme (no fullscreen).
             TV overrides this in MainActivity.onCreate() before super. -->
        <item name="postSplashScreenTheme">@style/Theme.ArflixTV.Mobile</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- ARVIO TV Theme - Arctic Fuse 2 Inspired (TV devices only) -->
    <style name="Theme.ArflixTV" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:colorPrimary">@color/arctic_white</item>
        <item name="android:colorAccent">@color/accent_white</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <!-- AppCompat / Material attributes required by MediaRouterThemeHelper and dialogs. -->
        <item name="colorPrimary">@color/arctic_white</item>
        <item name="colorPrimaryDark">@color/background_dark</item>
        <item name="colorAccent">@color/accent_white</item>
        <item name="colorSurface">@color/background_dark</item>
        <item name="colorOnSurface">@color/arctic_white</item>
    </style>

    <!-- ARVIO Mobile Theme - MaterialComponents-based so MaterialCardView, Dialogs, and MediaRouteChooserDialog work (phones/tablets). -->
    <style name="Theme.ArflixTV.Mobile" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:colorPrimary">@color/arctic_white</item>
        <item name="android:colorAccent">@color/accent_white</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <!-- Transparent bars — the dark app background shows through naturally -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- AppCompat / Material attrs required by MediaRouterThemeHelper & extension dialogs -->
        <item name="colorPrimary">@color/arctic_white</item>
        <item name="colorPrimaryDark">@color/background_dark</item>
        <item name="colorAccent">@color/accent_white</item>
        <item name="colorSurface">@color/background_dark</item>
        <item name="colorOnSurface">@color/arctic_white</item>
    </style>
</resources>
